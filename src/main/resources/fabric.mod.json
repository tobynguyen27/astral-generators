{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["tobynguyen27", "MikoTheBoi"],
    "contact": {
        "email": "hi@tobynguyen.dev",
        "homepage": "https://github.com/tobynguyen27/astral-generators",
        "issues": "https://github.com/tobynguyen27/astral-generators/issues",
        "sources": "https://github.com/tobynguyen27/astral-generators"
    },
    "license": "${mod_license}",
    "icon": "assets/astralgenerators/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.tobynguyen27.astralgenerators.AstralGenerators",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.tobynguyen27.astralgenerators.client.AGClient",
                "adapter": "kotlin"
            }
        ],
        "fabric-datagen": [
            {
                "value": "dev.tobynguyen27.astralgenerators.data.AGDataGen",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            {
                "value": "dev.tobynguyen27.astralgenerators.integration.ModMenu",
                "adapter": "kotlin"
            }
        ],
        "rei_client": [
            {
                "value": "dev.tobynguyen27.astralgenerators.integration.rei.AGREIPlugin",
                "adapter": "kotlin"
            }
        ],
        "jade": [
            {
                "value": "dev.tobynguyen27.astralgenerators.integration.jade.Jade",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": ["astralgenerators.mixins.json"],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=17",
        "fabric-api": "*",
        "fabric-language-kotlin": "*",
        "codebebelib": ">=2.0.0-beta",
        "sense": ">=1.0.2"
    }
}

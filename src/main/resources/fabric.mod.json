{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["tobynguyen27"],
    "contact": {
        "sources": "https://github.com/tobynguyen27/astral-generators"
    },
    "license": "${mod_license}",
    "icon": "assets/astralgenerators/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "dev.tobynguyen27.astralgenerators.AstralGenerators",
                "adapter": "kotlin"
            }
        ],
        "client": [
            {
                "value": "dev.tobynguyen27.astralgenerators.client.AGClient",
                "adapter": "kotlin"
            }
        ],
        "fabric-datagen": [
            {
                "value": "dev.tobynguyen27.astralgenerators.datagen.AGDataGen",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": ["astralgenerators.mixins.json"],
    "depends": {
        "fabricloader": ">=0.18.1",
        "minecraft": "~1.18.2",
        "java": ">=17",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    }
}
